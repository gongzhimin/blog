---
import bookConfig from '../../data/book-config.json';
import { getCollection } from 'astro:content';

const C = bookConfig;

// Build static demo pages from collections
const lifePosts = (await getCollection('life')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const blogPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());
function fmtDate(d: Date) { return d.toLocaleDateString('zh-CN', { year:'numeric', month:'2-digit', day:'2-digit' }); }

const pages: Record<number, string> = {};
pages[4] = ''; pages[6] = '';
pages[5] = `<div class="table-contents"><h1>目录</h1><ul>` +
  lifePosts.slice(0,4).map((p,i) => `<li><a href="#page/${7+i}">${p.data.title} <span>p.${1+i}</span></a></li>`).join('') +
  blogPosts.slice(0,4).map((p,i) => `<li><a href="#page/${7+lifePosts.length+i}">${p.data.title} <span>p.${1+lifePosts.length+i}</span></a></li>`).join('') +
  '</ul></div><span class="page-number">iii</span>';

let pn = 7, bp = 1;
lifePosts.forEach(post => { pages[pn] = `<div class="book-content"><h2>${post.data.title}</h2><p class="capital">${post.data.description||''}</p><p style="color:#999;font-size:13px">${fmtDate(post.data.date)}</p></div><span class="page-number">${bp}</span>`; pn++; bp++; });
blogPosts.forEach(post => { pages[pn] = `<div class="book-content"><h2>${post.data.title}</h2><p class="capital">${post.data.description||''}</p><p style="color:#999;font-size:13px">${fmtDate(post.data.pubDatetime)}</p></div><span class="page-number">${bp}</span>`; pn++; bp++; });
for (let p = pn; p <= 110; p++) pages[p] = '';

const runConfig = JSON.parse(JSON.stringify(bookConfig));
runConfig.book.turn.totalPages = Math.max(112, pn + 2);
runConfig.book.turn.backPage = runConfig.book.turn.totalPages - 1;
const backPage = runConfig.book.turn.backPage;
const totalPages = runConfig.book.turn.totalPages;
const NL = C.nav.light;
const FL = C.footer.light;
const DP = C.book.depth;
const FP = C.footer.padding;
const pageDepthAttrs = { depth: '5' };
---

<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=1050, user-scalable=no" />
<title>{C.nav.brand.text} · Book</title>

<script is:inline src="/vendor/turnjs/jquery.min.1.7.js"></script>
<script is:inline src="/vendor/turnjs/jquery-ui-1.8.20.custom.min.js"></script>
<script is:inline src="/vendor/turnjs/jquery.mousewheel.min.js"></script>
<script is:inline src="/vendor/turnjs/modernizr.2.5.3.min.js"></script>
<script is:inline src="/vendor/turnjs/hash.js"></script>
<link rel="stylesheet" href="/vendor/turnjs/css/jquery.ui.css" />
<link rel="stylesheet" href="/vendor/turnjs/css/steve-jobs.css" />

<style is:inline set:html={`
  :root {
    --nav-h: ${C.nav.height}px;
    --book-gap: ${C.book.gap}px;
    --depth-w: ${DP.width}px;
    --depth-h: ${DP.height}px;
    --depth-top: ${DP.top}px;
    --footer-pt: ${FP.top}px;
    --footer-pb: ${FP.bottom}px;
    --footer-fs: ${C.footer.fontSize}px;
    --copyright-fs: ${C.footer.copyrightFontSize}px;
  }
  body {
    overflow-x:hidden; overflow-y:auto;
    background: repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(0,0,0,0.02) 2px, rgba(0,0,0,0.02) 4px),
                repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.01) 2px, rgba(0,0,0,0.01) 4px),
                #e8e4de;
  }
  /* Nav */
  .site-nav{position:sticky;top:0;z-index:1000;width:100%;display:flex;align-items:center;justify-content:center;height:var(--nav-h);padding:0 24px;border-bottom:1px solid ${NL.border}}
  .site-nav .inner{display:flex;align-items:center;gap:${C.nav.innerGap}px}
  .site-nav .brand{font-size:${C.nav.brand.fontSize}px;letter-spacing:0.08em;color:${NL.brandText};text-decoration:none}
  .site-nav .links{display:flex;gap:${C.nav.links.gap}px;align-items:center}
  .site-nav .links a{font-size:${C.nav.links.fontSize}px;color:${NL.linkText};text-decoration:none}
  .site-nav .links a:hover{color:${NL.linkHover}}
  /* Footer */
  .site-footer{text-align:center;padding:var(--footer-pt) 24px var(--footer-pb);color:${FL.text};font-size:var(--footer-fs);border-top:1px solid ${FL.border}}
  .site-footer .quote{font-style:italic;color:${FL.quote};margin-bottom:6px}
  .site-footer .copyright{color:${FL.copyright};font-size:var(--copyright-fs);margin-top:8px}
  /* Book */
  #canvas{margin:0 auto;padding:var(--book-gap) 0}
`}></style>
</head>
<body>

<header class="site-nav">
  <div class="inner">
    <a class="brand" href="/">{C.nav.brand.text}</a>
    <nav class="links">
      {C.nav.links.items.map(l => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</header>

<div id="canvas">
  <div id="book-zoom">
    <div class="sj-book">
      <div {...pageDepthAttrs} class="hard"> <div class="side"></div> </div>
      <div {...pageDepthAttrs} class="hard front-side"> <div class="depth"></div> </div>
      <div class="own-size"></div>
      <div class="own-size even"></div>
      <div class={`hard fixed back-side p${backPage}`}> <div class="depth"></div> </div>
      <div class={`hard p${totalPages}`}></div>
    </div>
  </div>
  <div id="slider-bar" class="turnjs-slider">
    <div id="slider"></div>
  </div>
</div>

<footer class="site-footer">
  <div class="quote">"{C.footer.content.quoteEnglish}"</div>
  <div>{C.footer.content.quoteChinese}</div>
  <div style="margin-top:4px;color:#888">— {C.footer.content.author}</div>
  <div class="copyright">&copy; {new Date().getFullYear()} · {C.footer.content.copyright}</div>
</footer>

<div id="book-data" hidden
  data-config={JSON.stringify(runConfig)}
  data-content={JSON.stringify(pages)}
></div>
<script is:inline src="/vendor/turnjs/js/book-app.js"></script>

</body>
</html>
