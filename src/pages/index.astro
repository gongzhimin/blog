---
import { getCollection } from 'astro:content';
import { readFileSync } from 'fs';
import quote from '../data/daily-quote.json';
import bookConfig from '../data/book-config.json';
import { renderMarkdown, stripLeadingTitle, romanTocPage } from '../book/renderers/markdown-renderer.mjs';
import { createAstroBlogDocument } from '../book/sources/astro-blog-source.mjs';
import { buildBookRuntime } from '../book/assembler/build-book-runtime.mjs';
import { buildHomepageStyles } from '../book/homepage/build-homepage-styles.mjs';
import { loadBookTheme } from '../book/themes/load-theme.mjs';
import BookShell from '../book/components/BookShell.astro';
import BookRuntimeAssets from '../book/components/BookRuntimeAssets.astro';
import fontsCSS from '../styles/fonts.css?raw';
import bookContentCSS from '../styles/book-content.css?raw';
import codeHighlightCSS from '../styles/code-highlight.css?raw';
import bookTocCSS from '../styles/book-toc.css?raw';

const SITE_TITLE = bookConfig.footer.content.copyright;
const SITE_DESC = '文字留住瞬间。技术笔记与生活随笔。';

// KaTeX CSS is included in the measurement container so pagination uses the
// same formula metrics that the visible book pages use.
const katexCSS = readFileSync('node_modules/katex/dist/katex.min.css', 'utf8');
const theme = loadBookTheme(bookConfig.theme?.id, {
  fontsCSS,
  bookContentCSS,
  codeHighlightCSS,
  bookTocCSS,
  katexCSS,
});

const lifePosts = await getCollection('life');
const blogPosts = await getCollection('blog');
const bookDocument = createAstroBlogDocument({ lifePosts, blogPosts });
const runtime = buildBookRuntime({
  document: bookDocument,
  bookConfig,
  renderMarkdown,
  stripLeadingTitle,
  romanTocPage,
});
const runConfig = runtime.config;
runConfig.theme = theme.runtime;

const nav = bookConfig.nav;
const footer = bookConfig.footer;
const cover = bookConfig.book.coverSprite;
const mobileCanvas = bookConfig.book.mobileCanvas;
const mobileContentPage = bookConfig.book.mobileContentPage;
const light = {
  nav: nav.light,
  footer: footer.light,
  background: bookConfig.backgrounds.light,
};
const homepageStyles = buildHomepageStyles({
  book: bookConfig.book,
  cover,
  footer,
  light,
  mobileCanvas,
  mobileContentPage,
  nav,
  theme,
});

const quoteEnglish = quote.english || footer.content.quoteEnglish;
const quoteChinese = quote.chinese || footer.content.quoteChinese;
const quoteAuthor = quote.author || footer.content.author;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{SITE_TITLE}</title>
    <meta name="description" content={SITE_DESC} />
    <meta name="viewport" content="width=1050, user-scalable=no" />
    <link rel="preconnect" href="https://fonts.loli.net" />
    <link rel="preconnect" href="https://gstatic.loli.net" crossorigin />
    <link href="https://fonts.loli.net/css2?family=Chiron+Sung+HK&display=swap" rel="stylesheet" />
    <BookRuntimeAssets />
    <style is:inline set:html={homepageStyles}></style>
  </head>
  <body>
    <header class="site-nav">
      <div class="inner">
        <a class="brand" href="/">{nav.brand.text}</a>
        <nav class="links">
          {nav.links.items.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <BookShell
      runConfig={runConfig}
      measureArticleCSS={theme.measurement.articleCSS}
      measureTocCSS={theme.measurement.tocCSS}
    />

    <footer class="site-footer">
      <div class="quote">"{quoteEnglish}"</div>
      <div>{quoteChinese}</div>
      <div style="margin-top:4px;color:#888">— {quoteAuthor}</div>
      <div class="copyright">
        &copy; {new Date().getFullYear()} · {footer.content.copyright}
      </div>
    </footer>
  </body>
</html>
