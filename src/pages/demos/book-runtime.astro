---
import { readFileSync } from 'fs';
import bookConfig from '../../data/book-config.json';
import sampleBook from '../../data/books/sample.json';
import { renderMarkdown, stripLeadingTitle, romanTocPage } from '../../book/renderers/markdown-renderer.mjs';
import { buildBookRuntime } from '../../book/assembler/build-book-runtime.mjs';
import { validateBookConfig } from '../../book/config/book-config.mjs';
import { buildHomepageStyles } from '../../book/homepage/build-homepage-styles.mjs';
import { createJsonBookDocument } from '../../book/sources/json-book-source.mjs';
import { loadBundledBookTheme } from '../../book/themes/bundled-theme.mjs';
import BookShell from '../../book/components/BookShell.astro';
import BookRuntimeAssets from '../../book/components/BookRuntimeAssets.astro';
import CursorDot from '../../components/CursorDot.astro';
import tokensCSS from '../../styles/tokens.css?raw';

const katexCSS = readFileSync('node_modules/katex/dist/katex.min.css', 'utf8');
const demoConfig = JSON.parse(JSON.stringify(bookConfig));
demoConfig.theme = { id: 'plain-manuscript' };
demoConfig.footer.content.copyright = 'Book Runtime Demo';
validateBookConfig(demoConfig);

const theme = loadBundledBookTheme(demoConfig.theme.id, { katexCSS });
const bookDocument = createJsonBookDocument(sampleBook);
const runtime = buildBookRuntime({
  document: bookDocument,
  bookConfig: demoConfig,
  renderMarkdown,
  stripLeadingTitle,
  romanTocPage,
});
const runConfig = runtime.config;
runConfig.theme = theme.runtime;

const homepageStyles = buildHomepageStyles({
  book: demoConfig.book,
  cover: demoConfig.book.coverSprite,
  footer: demoConfig.footer,
  light: {
    nav: demoConfig.nav.light,
    footer: demoConfig.footer.light,
    background: demoConfig.backgrounds.light,
  },
  mobileCanvas: demoConfig.book.mobileCanvas,
  mobileContentPage: demoConfig.book.mobileContentPage,
  nav: demoConfig.nav,
  theme,
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>Book Runtime Demo</title>
    <meta name="viewport" content="width=1050, user-scalable=no" />
    <BookRuntimeAssets />
    <style is:inline set:html={tokensCSS}></style>
    <style is:inline set:html={homepageStyles}></style>
  </head>
  <body data-cursor-hover="nav">
    <header class="site-nav">
      <div class="inner">
        <a class="brand" href="/demos/book-runtime/">
          <span class="cursor-text">Book Runtime Demo</span>
        </a>
        <span class="nav-slogan"><span class="cursor-text">{demoConfig.nav.slogan}</span></span>
      </div>
    </header>

    <BookShell
      runConfig={runConfig}
      measureArticleCSS={theme.measurement.articleCSS}
      measureTocCSS={theme.measurement.tocCSS}
    />
    <CursorDot />
  </body>
</html>
