---
import { getCollection } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { renderMarkdown, stripLeadingTitle } from '../../book/renderers/markdown-renderer.mjs';

export async function getStaticPaths() {
  const posts = (await getCollection('life')).filter(p => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const body = post.body || '';
const html = renderMarkdown(stripLeadingTitle(body, post.data.title));
---

<PostLayout {...post.data} collection="life">
  <Fragment set:html={html} />
</PostLayout>
