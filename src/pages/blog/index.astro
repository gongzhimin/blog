---
import '../../styles/global.css';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog');
const sortedPosts = blogPosts.sort((a, b) => {
  const dateA = a.data.pubDatetime || a.data.date;
  const dateB = b.data.pubDatetime || b.data.date;
  return dateB.valueOf() - dateA.valueOf();
});
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Technical Archive · Zhimin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="site-shell site-shell--narrow">
      <a href="/" class="article-page__back">← Back</a>

      <header class="archive-page__intro">
        <p class="site-eyebrow">Technical archive</p>
        <h1>Technical</h1>
        <p>All technical writings and guides, sorted by the time they were published.</p>
      </header>

      <div class="archive-list">
        {sortedPosts.map((post) => {
          const date = post.data.pubDatetime || post.data.date;
          return (
            <article class="archive-row">
              <a href={`/blog/${post.id}`} class="archive-row__title">
                {post.data.title}
              </a>
              <time class="archive-row__date">
                {date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
            </article>
          );
        })}
      </div>
    </main>
  </body>
</html>
