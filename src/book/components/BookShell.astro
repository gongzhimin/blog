---
const {
  runConfig,
  measureArticleCSS,
  measureTocCSS,
  depth = '5',
} = Astro.props;

const backPage = runConfig.book.turn.backPage;
const totalPages = runConfig.book.turn.totalPages;
const pageDepthAttrs = { depth };
const ignoredDecorationAttrs = { ignore: '1', 'aria-hidden': 'true' } as const;
const measureCSS =
  `var MEASURE_CSS={article:${JSON.stringify(measureArticleCSS)},toc:${JSON.stringify(measureTocCSS)}};`;
---

<main>
  <div id="canvas">
    <div id="book-zoom">
      <div class="sj-book">
        <div ignore="1" aria-hidden="true" class="depth book-depth book-depth--front"></div>
        <div ignore="1" aria-hidden="true" class="depth book-depth book-depth--back"></div>
        <div {...ignoredDecorationAttrs} class="book-cover-underlay book-cover-underlay--front"></div>
        <div {...ignoredDecorationAttrs} class="book-cover-underlay book-cover-underlay--back"></div>
        <div {...pageDepthAttrs} class="hard">
          <div class="side"></div>
        </div>
        <div {...pageDepthAttrs} class="hard front-side"></div>
        <div class="own-size"></div>
        <div class="own-size even"></div>
        <div class={`hard fixed back-side p${backPage}`}></div>
        <div class={`hard p${totalPages}`}></div>
      </div>
    </div>
    <div id="slider-bar" class="turnjs-slider">
      <div id="slider"></div>
    </div>
  </div>
</main>

<div id="book-data" hidden data-config={JSON.stringify(runConfig)}></div>
<script is:inline set:html={measureCSS}></script>
<script is:inline src="/book-runtime/js/paginator-core.js"></script>
<script is:inline src="/book-runtime/js/paginator-splitters.js"></script>
<script is:inline src="/book-runtime/js/paginator.js"></script>
<script is:inline src="/book-runtime/js/orchestrator.js"></script>
<script is:inline src="/book-runtime/js/turnjs-adapter.js"></script>
<script is:inline src="/book-runtime/js/book-app.js"></script>
