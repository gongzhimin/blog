---
import { createSpecialPages } from '../internal/presentation/special-pages/index.mjs';

// The Site owns this Astro presentation component; Book Build supplies its data.
const {
  runConfig,
  measureArticleCSS,
  measureTocCSS,
  depth = '5',
} = Astro.props;

const backPage = runConfig.book.turn.backPage;
const totalPages = runConfig.book.turn.totalPages;
const pageDepthAttrs = { depth };
const ignoredDecorationAttrs = { ignore: '1', 'aria-hidden': 'true' } as const;
const measureCSS = `window.MEASURE_CSS={article:${JSON.stringify(measureArticleCSS)},toc:${JSON.stringify(measureTocCSS)}};`;
const specialPages: ReturnType<typeof createSpecialPages> =
  runConfig.specialPages || createSpecialPages(runConfig);
const payload = { ...runConfig, specialPages };
const physicalPages: Record<string, number> = {
  frontCover: 1,
  frontInside: 2,
  titlePage: 3,
  imprintPage: 4,
  backInside: backPage,
  backCover: totalPages,
};
---

<main>
  <div id="canvas">
    <div id="book-zoom">
      <div class="sj-book">
        <div
          {...ignoredDecorationAttrs}
          class="depth book-depth book-depth--front"
        ></div>
        <div
          {...ignoredDecorationAttrs}
          class="depth book-depth book-depth--back"
        ></div>
        <div
          {...ignoredDecorationAttrs}
          class="book-cover-underlay book-cover-underlay--front"
        ></div>
        <div
          {...ignoredDecorationAttrs}
          class="book-cover-underlay book-cover-underlay--back"
        ></div>
        {Object.entries(specialPages).map(([role, page]) => (
          <div
            {...(page.className.includes('hard') ? pageDepthAttrs : {})}
            class={page.className + ' p' + physicalPages[role]}
            set:html={page.html}
          />
        ))}
      </div>
    </div>
    <div id="slider-bar" class="turnjs-slider">
      <div id="slider"></div>
    </div>
  </div>
</main>

<div id="book-data" hidden data-config={JSON.stringify(payload)}></div>
<script is:inline set:html={measureCSS}></script>
