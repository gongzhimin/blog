{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Book Runtime Config",
  "description": "博客书运行时配置：主题、导航、书本几何尺寸、封面精灵图、分页参数、页脚与背景。",
  "type": "object",
  "additionalProperties": true,
  "required": ["theme", "nav", "book", "footer", "backgrounds"],
  "properties": {
    "theme": {
      "type": "object",
      "description": "当前使用的书本主题。",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "主题 ID。",
          "enum": ["classic-paper", "plain-manuscript"]
        }
      }
    },
    "nav": {
      "type": "object",
      "description": "首页导航栏配置。",
      "required": ["brand", "slogan", "links"],
      "properties": {
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "导航高度。"
        },
        "brand": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "description": "导航品牌。"
            }
          }
        },
        "slogan": {
          "type": "string"
        },
        "links": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["href", "label"],
                "properties": {
                  "href": {
                    "type": "string",
                    "minLength": 1,
                    "description": "链接地址。"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "description": "链接文字。"
                  }
                }
              }
            }
          }
        }
      }
    },
    "book": {
      "type": "object",
      "description": "书本几何尺寸、Turn.js 参数、封面精灵图、纸张背景图集和分页配置。",
      "required": [
        "canvasWidth",
        "width",
        "height",
        "mobileBreakpoint",
        "mobileCanvas",
        "contentPage",
        "mobileContentPage",
        "turn",
        "coverSprite",
        "pagination"
      ],
      "properties": {
        "canvasWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "桌面端书本外层画布宽度。"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "桌面端书本宽度。"
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "桌面端书本高度。"
        },
        "mobileBreakpoint": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "切换移动端单页模式的窗口宽度断点。"
        },
        "mobileCanvas": {
          "type": "object",
          "description": "移动端书本外层画布尺寸与留白。",
          "required": ["width", "paddingY"],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "width，正数。"
            },
            "paddingY": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "paddingY，正数。"
            }
          }
        },
        "contentPage": {
          "type": "object",
          "description": "桌面端正文页尺寸。",
          "required": ["width", "height"],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "width，正数。"
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "height，正数。"
            }
          }
        },
        "mobileContentPage": {
          "type": "object",
          "description": "移动端单页正文页尺寸。",
          "required": ["width", "height"],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "width，正数。"
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "height，正数。"
            }
          }
        },
        "turn": {
          "type": "object",
          "description": "Turn.js 初始化参数。totalPages 是启动估算值，浏览器端分页完成后会按实际内容页数动态覆盖。",
          "required": ["elevation", "duration", "totalPages", "startPage"],
          "properties": {
            "totalPages": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "启动时用于创建 Turn.js 的估算页数；运行时会由分页结果替换，不代表固定总页数。"
            },
            "elevation": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "elevation，正数。"
            },
            "duration": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "duration，正数。"
            },
            "startPage": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "startPage，正数。"
            }
          }
        },
        "coverSprite": {
          "type": "object",
          "description": "封面精灵图路径、背景尺寸和各封面位置。",
          "required": ["image", "backgroundSize", "positions"],
          "properties": {
            "image": {
              "type": "string",
              "description": "封面精灵图 URL。",
              "minLength": 1
            },
            "backgroundSize": {
              "type": "string",
              "description": "CSS background-size 值。",
              "minLength": 1
            },
            "positions": {
              "type": "object",
              "description": "封面、内封、封底对应的 background-position。",
              "required": [
                "front",
                "frontInside",
                "backInside",
                "back",
                "backOuter"
              ],
              "properties": {
                "front": {
                  "type": "string",
                  "minLength": 1,
                  "description": "封面位置 front"
                },
                "frontInside": {
                  "type": "string",
                  "minLength": 1,
                  "description": "封面位置 frontInside"
                },
                "titlePage": {
                  "type": "string",
                  "minLength": 1,
                  "description": "扉页插画位置；省略时兼容使用 backInside。Site 当前配置显式指定，不能与封底内侧混用。"
                },
                "backInside": {
                  "type": "string",
                  "minLength": 1,
                  "description": "封面位置 backInside"
                },
                "back": {
                  "type": "string",
                  "minLength": 1,
                  "description": "封面位置 back"
                },
                "backOuter": {
                  "type": "string",
                  "minLength": 1,
                  "description": "封面位置 backOuter"
                }
              }
            }
          }
        },
        "paperTexture": {
          "type": "object",
          "description": "纸张背景图集配置。启用后，每个正文页会从同一张大背景图中确定性裁剪不同位置，避免所有页面纸纹完全重复。",
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "是否启用纸张背景图集。"
            },
            "image": {
              "type": "string",
              "description": "纸张背景图 URL，通常放在 public 目录并以 / 开头引用。",
              "minLength": 1
            },
            "size": {
              "type": "string",
              "description": "CSS background-size 值，用于控制图集在书页上的裁剪尺度。",
              "minLength": 1
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "纸纹叠加透明度。"
            },
            "blendMode": {
              "type": "string",
              "description": "CSS mix-blend-mode 值，用于控制纸纹与原纸色的混合方式。",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": ["enabled"]
              },
              "then": {
                "required": ["image"]
              }
            }
          ]
        },
        "pagination": {
          "type": "object",
          "description": "分页测量参数，决定浏览器端正文、目录和移动端分页尺寸。",
          "required": [
            "contentWidth",
            "contentHeight",
            "tocWidth",
            "tocHeight"
          ],
          "properties": {
            "contentWidth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "contentWidth，正数。"
            },
            "contentHeight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "contentHeight，正数。"
            },
            "tocWidth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "tocWidth，正数。"
            },
            "tocHeight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "tocHeight，正数。"
            }
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "description": "页脚与每日一句默认文案。",
      "required": ["content"],
      "properties": {
        "content": {
          "type": "object",
          "required": ["copyright"],
          "properties": {
            "copyright": {
              "type": "string"
            }
          }
        }
      }
    },
    "backgrounds": {
      "type": "object",
      "description": "页面背景材质。",
      "required": ["light"],
      "properties": {
        "light": {
          "type": "object",
          "required": ["fabric"],
          "properties": {
            "fabric": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
