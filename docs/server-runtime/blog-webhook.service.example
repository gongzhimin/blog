[Unit]
Description=Astro Blog Webhook Receiver
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/blog
Environment=BLOG_GITHUB_REPO=gongzhimin/blog
Environment=BLOG_GITHUB_BRANCH=main
EnvironmentFile=-/etc/blog-webhook.env
ExecStart=/usr/bin/node /var/www/blog/scripts/webhook-receiver.cjs
Restart=always

[Install]
WantedBy=multi-user.target
