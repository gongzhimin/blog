{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "homepage-config.schema.json",
  "title": "首页配置",
  "description": "首页文案、布局、独立文字角色和书本材质配置。修改后构建会自动校验。",
  "type": "object",
  "additionalProperties": false,
  "required": ["content", "desktop", "mobile", "textStyles", "materials"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "指向本 Schema，让编辑器显示中文说明和自动补全。"
    },
    "content": {
      "type": "object",
      "description": "首页、导航、书页和版权直接展示的文字。",
      "additionalProperties": false,
      "required": [
        "siteName",
        "navigationTitle",
        "copyrightLabel",
        "navigation",
        "life",
        "technical"
      ],
      "properties": {
        "siteName": {
          "$ref": "#/$defs/text",
          "description": "导航栏左侧的站点名称。"
        },
        "navigationTitle": {
          "$ref": "#/$defs/text",
          "description": "导航栏中间的首页标题；空间不足时省略或隐藏。"
        },
        "copyrightLabel": {
          "$ref": "#/$defs/text",
          "description": "版权年份和分隔点之后的文字，不包含 © 和年份。"
        },
        "navigation": {
          "$ref": "#/$defs/navigationLabels",
          "description": "导航栏四个文字入口。"
        },
        "life": {
          "$ref": "#/$defs/bookSection",
          "description": "生活文章左页及生活目录页的文字。"
        },
        "technical": {
          "$ref": "#/$defs/bookSection",
          "description": "技术文章右页及技术目录页的文字。"
        }
      }
    },
    "desktop": {
      "type": "object",
      "description": "宽度大于 720px 时使用的桌面参数。",
      "additionalProperties": false,
      "required": ["regions", "book"],
      "properties": {
        "regions": {
          "type": "object",
          "description": "桌面首页各区域尺寸。",
          "additionalProperties": false,
          "required": [
            "navigationHeight",
            "bookRegionHeight",
            "footerHeight",
            "siteWidth"
          ],
          "properties": {
            "navigationHeight": {
              "$ref": "#/$defs/length",
              "description": "导航栏高度，建议使用 svh。"
            },
            "bookRegionHeight": {
              "$ref": "#/$defs/length",
              "description": "删除独立头部区后的书本内容区高度。"
            },
            "footerHeight": {
              "$ref": "#/$defs/length",
              "description": "每日一句和版权区域高度。"
            },
            "siteWidth": {
              "$ref": "#/$defs/length",
              "description": "导航、书本内容区和页脚共用的页面宽度。"
            }
          }
        },
        "book": {
          "type": "object",
          "description": "桌面精装书的尺寸、比例和页内间距。",
          "additionalProperties": false,
          "required": [
            "width",
            "aspectRatio",
            "perspective",
            "rotateX",
            "shadowOffsetY",
            "shadowBlur",
            "coverInsetTop",
            "coverInsetInline",
            "coverInsetBottom",
            "coverRadius",
            "bindingWidth",
            "edgeWidth",
            "gutterWidth",
            "pagePaddingTop",
            "pagePaddingInline",
            "pagePaddingBottom",
            "partMarginTop",
            "partMarginBottom",
            "partPaddingTop",
            "catalogGap",
            "catalogColumnGap",
            "archiveBottom",
            "folioBottom"
          ],
          "properties": {
            "width": {
              "$ref": "#/$defs/length",
              "description": "书本相对于内容区的宽度，例如 68%。"
            },
            "aspectRatio": {
              "$ref": "#/$defs/ratio",
              "description": "书本宽高比；数值越大，书本越扁宽。"
            },
            "perspective": {
              "$ref": "#/$defs/length",
              "description": "书本 3D 透视距离，数值越大透视越弱。"
            },
            "rotateX": {
              "$ref": "#/$defs/angle",
              "description": "书本沿 X 轴的轻微倾角。"
            },
            "shadowOffsetY": {
              "$ref": "#/$defs/length",
              "description": "书本投影向下偏移。"
            },
            "shadowBlur": {
              "$ref": "#/$defs/length",
              "description": "书本投影模糊半径。"
            },
            "coverInsetTop": {
              "$ref": "#/$defs/length",
              "description": "硬壳封面超出纸页顶部的距离。"
            },
            "coverInsetInline": {
              "$ref": "#/$defs/length",
              "description": "硬壳封面超出纸页左右两侧的距离。"
            },
            "coverInsetBottom": {
              "$ref": "#/$defs/length",
              "description": "硬壳封面超出纸页底部的距离。"
            },
            "coverRadius": {
              "$ref": "#/$defs/length",
              "description": "硬壳封面的圆角。"
            },
            "bindingWidth": {
              "$ref": "#/$defs/length",
              "description": "纸页后方装订布的宽度。"
            },
            "edgeWidth": {
              "$ref": "#/$defs/length",
              "description": "左右书口纸层的宽度。"
            },
            "gutterWidth": {
              "$ref": "#/$defs/length",
              "description": "两页中央中缝实体线宽度。"
            },
            "pagePaddingTop": {
              "$ref": "#/$defs/length",
              "description": "纸页内容顶部内边距。"
            },
            "pagePaddingInline": {
              "$ref": "#/$defs/length",
              "description": "纸页内容左右内边距。"
            },
            "pagePaddingBottom": {
              "$ref": "#/$defs/length",
              "description": "纸页内容底部内边距。"
            },
            "partMarginTop": {
              "$ref": "#/$defs/length",
              "description": "Part 链接上方间距。"
            },
            "partMarginBottom": {
              "$ref": "#/$defs/length",
              "description": "Part 链接下方间距。"
            },
            "partPaddingTop": {
              "$ref": "#/$defs/length",
              "description": "Part 链接上边线与文字的间距。"
            },
            "catalogGap": {
              "$ref": "#/$defs/length",
              "description": "目录文章之间的纵向间距。"
            },
            "catalogColumnGap": {
              "$ref": "#/$defs/length",
              "description": "标题、点线和日期之间的横向间距。"
            },
            "archiveBottom": {
              "$ref": "#/$defs/length",
              "description": "View all 入口距离纸页底部的位置。"
            },
            "folioBottom": {
              "$ref": "#/$defs/length",
              "description": "罗马数字页码距离纸页底部的位置。"
            }
          }
        }
      }
    },
    "mobile": {
      "type": "object",
      "description": "宽度不超过 720px 时使用的移动端参数。",
      "additionalProperties": false,
      "required": ["layout"],
      "properties": {
        "layout": {
          "type": "object",
          "description": "移动端布局尺寸。",
          "additionalProperties": false,
          "required": [
            "navigationHeight",
            "siteInlinePadding",
            "bookGap",
            "pageMinHeight",
            "pagePaddingTop",
            "pagePaddingInline",
            "pagePaddingBottom",
            "partMarginTop",
            "partMarginBottom",
            "partPaddingTop",
            "catalogGap"
          ],
          "properties": {
            "navigationHeight": {
              "$ref": "#/$defs/length",
              "description": "移动端导航栏高度。"
            },
            "siteInlinePadding": {
              "$ref": "#/$defs/length",
              "description": "移动端页面左右留白，每侧各使用一次。"
            },
            "bookGap": {
              "$ref": "#/$defs/length",
              "description": "移动端两张纸页之间的距离。"
            },
            "pageMinHeight": {
              "$ref": "#/$defs/length",
              "description": "移动端单张目录纸页的最小高度。"
            },
            "pagePaddingTop": {
              "$ref": "#/$defs/length",
              "description": "移动端纸页顶部内边距。"
            },
            "pagePaddingInline": {
              "$ref": "#/$defs/length",
              "description": "移动端纸页左右内边距。"
            },
            "pagePaddingBottom": {
              "$ref": "#/$defs/length",
              "description": "移动端纸页底部内边距。"
            },
            "partMarginTop": {
              "$ref": "#/$defs/length",
              "description": "移动端 Part 链接上方间距。"
            },
            "partMarginBottom": {
              "$ref": "#/$defs/length",
              "description": "移动端 Part 链接下方间距。"
            },
            "partPaddingTop": {
              "$ref": "#/$defs/length",
              "description": "移动端 Part 链接上边线与文字的间距。"
            },
            "catalogGap": {
              "$ref": "#/$defs/length",
              "description": "移动端目录文章之间的距离。"
            }
          }
        }
      }
    },
    "textStyles": {
      "type": "object",
      "description": "首页每种文字角色的独立字体、字号和明暗模式颜色。",
      "additionalProperties": false,
      "required": [
        "navigationBrand",
        "navigationTitle",
        "navigationLinks",
        "runningOuter",
        "runningInner",
        "partLink",
        "catalogTitle",
        "catalogDate",
        "archiveLink",
        "folio",
        "quoteEnglish",
        "quoteTranslation",
        "quoteAuthor",
        "copyright"
      ],
      "properties": {
        "navigationBrand": {
          "$ref": "#/$defs/textStyle",
          "description": "导航左侧品牌文字。"
        },
        "navigationTitle": {
          "$ref": "#/$defs/textStyle",
          "description": "导航标题文字，独立于品牌和导航链接。"
        },
        "navigationLinks": {
          "$ref": "#/$defs/textStyle",
          "description": "生活、技术、关于、RSS 导航链接。"
        },
        "runningOuter": {
          "$ref": "#/$defs/textStyle",
          "description": "书页靠外缘的 ESSAYS / TECHNICAL NOTES 页眉。"
        },
        "runningInner": {
          "$ref": "#/$defs/textStyle",
          "description": "书页靠中缝的 CONTENTS 页眉。"
        },
        "partLink": {
          "$ref": "#/$defs/textStyle",
          "description": "可点击的 PART I / PART II 链接。"
        },
        "catalogTitle": {
          "$ref": "#/$defs/textStyle",
          "description": "书内文章目录标题。"
        },
        "catalogDate": {
          "$ref": "#/$defs/textStyle",
          "description": "书内文章日期。"
        },
        "archiveLink": {
          "$ref": "#/$defs/textStyle",
          "description": "View all essays / technical notes 入口。"
        },
        "folio": {
          "$ref": "#/$defs/textStyle",
          "description": "首页书页和子目录页的罗马数字页码。"
        },
        "quoteEnglish": {
          "$ref": "#/$defs/textStyle",
          "description": "每日一句英文原文。"
        },
        "quoteTranslation": {
          "$ref": "#/$defs/textStyle",
          "description": "每日一句中文译文。"
        },
        "quoteAuthor": {
          "$ref": "#/$defs/textStyle",
          "description": "每日一句作者。"
        },
        "copyright": {
          "$ref": "#/$defs/textStyle",
          "description": "独立版权文字。"
        }
      }
    },
    "materials": {
      "type": "object",
      "description": "精装书材质和颜色。",
      "additionalProperties": false,
      "required": [
        "paperColor",
        "coverColor",
        "bindingColor",
        "pageEdgeColor",
        "gutterColor",
        "pageTextColor",
        "pageMutedColor",
        "pageAccentColor",
        "bookShadowColor",
        "paperTextureOpacity"
      ],
      "properties": {
        "paperColor": {
          "$ref": "#/$defs/color",
          "description": "顶层纸张颜色。"
        },
        "coverColor": {
          "$ref": "#/$defs/color",
          "description": "纸页后方硬壳封面的颜色。"
        },
        "bindingColor": {
          "$ref": "#/$defs/color",
          "description": "顶部和底部露出的装订布颜色。"
        },
        "pageEdgeColor": {
          "$ref": "#/$defs/color",
          "description": "左右书口纸层的基础颜色。"
        },
        "gutterColor": {
          "$ref": "#/$defs/color",
          "description": "中央中缝颜色。"
        },
        "pageTextColor": {
          "$ref": "#/$defs/color",
          "description": "桌面书页基础正文颜色。"
        },
        "pageMutedColor": {
          "$ref": "#/$defs/color",
          "description": "书页基础次要文字颜色。"
        },
        "pageAccentColor": {
          "$ref": "#/$defs/color",
          "description": "书页基础强调色。"
        },
        "bookShadowColor": {
          "$ref": "#/$defs/color",
          "description": "整本书外部投影颜色。"
        },
        "paperTextureOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "纸张颗粒纹理强度，0 为无纹理，1 为最强。"
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "length": {
      "type": "string",
      "pattern": "^-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:rem|px|%|svh|vw|em)$"
    },
    "angle": {
      "type": "string",
      "pattern": "^-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:deg|rad|turn)$"
    },
    "ratio": {
      "type": "string",
      "pattern": "^(?:\\d+(?:\\.\\d+)?|\\.\\d+)\\s*/\\s*(?:\\d+(?:\\.\\d+)?|\\.\\d+)$"
    },
    "color": {
      "type": "string",
      "pattern": "^(?:#[\\da-fA-F]{3,8}|rgba?\\(\\s*[\\d.%\\s,/-]+\\))$"
    },
    "navigationLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifeLabel",
        "technicalLabel",
        "aboutLabel",
        "rssLabel"
      ],
      "properties": {
        "lifeLabel": {
          "$ref": "#/$defs/text",
          "description": "生活目录导航文字。"
        },
        "technicalLabel": {
          "$ref": "#/$defs/text",
          "description": "技术目录导航文字。"
        },
        "aboutLabel": {
          "$ref": "#/$defs/text",
          "description": "关于页面导航文字。"
        },
        "rssLabel": {
          "$ref": "#/$defs/text",
          "description": "RSS 导航文字。"
        }
      }
    },
    "bookSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outerRunningLabel",
        "innerRunningLabel",
        "partLabel",
        "archiveLabel",
        "homepageFolio",
        "directoryFolio"
      ],
      "properties": {
        "outerRunningLabel": {
          "$ref": "#/$defs/text",
          "description": "书页靠外缘的栏目页眉。"
        },
        "innerRunningLabel": {
          "$ref": "#/$defs/text",
          "description": "书页靠中缝的 CONTENTS 页眉。"
        },
        "partLabel": {
          "$ref": "#/$defs/text",
          "description": "可点击的 Part 链接文字。"
        },
        "archiveLabel": {
          "$ref": "#/$defs/text",
          "description": "纸页底部进入全部文章目录的英文链接。"
        },
        "homepageFolio": {
          "$ref": "#/$defs/text",
          "description": "首页该书页的罗马数字页码。"
        },
        "directoryFolio": {
          "$ref": "#/$defs/text",
          "description": "对应子目录页独立使用的罗马数字页码。"
        }
      }
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fontFamily",
        "desktopSize",
        "mobileSize",
        "lightColor",
        "darkColor"
      ],
      "properties": {
        "fontFamily": {
          "type": "string",
          "enum": ["serif", "sans", "monospace"],
          "description": "该文字角色独立使用的字体族标记。"
        },
        "desktopSize": {
          "$ref": "#/$defs/length",
          "description": "该文字角色的桌面字号。"
        },
        "mobileSize": {
          "$ref": "#/$defs/length",
          "description": "该文字角色的移动端字号。"
        },
        "lightColor": {
          "$ref": "#/$defs/color",
          "description": "该文字角色在亮色模式中的颜色。"
        },
        "darkColor": {
          "$ref": "#/$defs/color",
          "description": "该文字角色在暗色模式中的颜色。"
        }
      }
    }
  }
}
