{
	"$schema": "./book-config.schema.json",
	"theme": {
		"id": "classic-paper"
	},
	"nav": {
		"height": 56,
		"innerGap": 28,
		"slogan": "记录技术，也记录技术之外的生活",
		"sloganFontSize": 13,
		"brand": {
			"text": "ZHIMIN",
			"fontSize": 17
		},
		"links": {
			"gap": 18,
			"fontSize": 14,
			"items": [
				{
					"label": "生活",
					"href": "/life"
				},
				{
					"label": "技术",
					"href": "/blog"
				},
				{
					"label": "关于",
					"href": "/about"
				},
				{
					"label": "RSS",
					"href": "/rss.xml"
				}
			]
		},
		"dark": {
			"border": "rgba(255,255,255,0.08)",
			"brandText": "#c4beb6",
			"linkText": "#888",
			"linkHover": "#c4beb6"
		},
		"light": {
			"border": "rgba(0,0,0,0.08)",
			"brandText": "#555",
			"linkText": "#999",
			"sloganText": "#999",
			"linkHover": "#444"
		}
	},
	"book": {
		"canvasWidth": 960,
		"width": 960,
		"height": 600,
		"mobileBreakpoint": 800,
		"mobileCanvas": {
			"width": 370,
			"paddingY": 16
		},
		"contentAreaHeight": 405,
		"hardPage": {
			"width": 480,
			"height": 600
		},
		"contentPage": {
			"width": 460,
			"height": 582
		},
		"mobileContentPage": {
			"width": 370,
			"height": 507
		},
		"depth": {
			"width": 16,
			"height": 590,
			"top": 7
		},
		"spineStrip": {
			"width": 5,
			"left": 475
		},
		"turn": {
			"elevation": 50,
			"duration": 1000,
			"totalPages": 112,
			"startPage": 7
		},
		"coverSprite": {
			"image": "/vendor/turnjs/pics/book-covers.jpg",
			"backgroundSize": "2400px 600px",
			"positions": {
				"front": "0 0",
				"frontInside": "-483px 0",
				"backInside": "-1936px 0",
				"back": "-968px 0",
				"backOuter": "-1452px 0"
			}
		},
		"paperTexture": {
			"enabled": true,
			"image": "/paper-bg-3.jpg",
			"size": "736px 1097px",
			"opacity": 0.3,
			"blendMode": "normal"
		},
		"gap": 30,
		"pagination": {
			"contentWidth": 380,
			"contentHeight": 471,
			"tocWidth": 380,
			"tocHeight": 400,
			"mobilePagination": {
				"contentWidth": 280,
				"contentHeight": 380,
				"tocWidth": 280,
				"tocHeight": 320
			}
		}
	},
	"footer": {
		"padding": {
			"top": 20,
			"bottom": 48
		},
		"fontSize": 13,
		"copyrightFontSize": 11,
		"content": {
			"quoteEnglish": "To free us from the expectations of others, to give us back to ourselves.",
			"quoteChinese": "将自己从他人的期待中解放出来，把自己还给自己",
			"author": "Joan Didion",
			"copyright": "Zhimin 的博客书"
		},
		"dark": {
			"border": "rgba(255,255,255,0.08)",
			"text": "#666",
			"quote": "#999",
			"copyright": "#555"
		},
		"light": {
			"border": "rgba(0,0,0,0.08)",
			"text": "#999",
			"quote": "#777",
			"copyright": "#bbb"
		}
	},
	"backgrounds": {
		"dark": {
			"solid": "#3a3632",
			"radial": "radial-gradient(ellipse at 50% 40%, #4a4540 0%, #2a2622 100%)",
			"noise": "#3a3632",
			"vignette": "radial-gradient(ellipse at 50% 45%, #3a3632 0%, #1a1816 100%)",
			"gradient": "linear-gradient(180deg, #2a2622 0%, #3a3632 50%, #2a2622 100%)",
			"fabric": "repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(0,0,0,0.04) 2px, rgba(0,0,0,0.04) 4px), repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255,255,255,0.01) 2px, rgba(255,255,255,0.01) 4px), #3a3632"
		},
		"light": {
			"solid": "#e8e4de",
			"radial": "radial-gradient(ellipse at 50% 40%, #f0ece6 0%, #d8d2ca 100%)",
			"noise": "#e8e4de",
			"vignette": "radial-gradient(ellipse at 50% 45%, #e8e4de 0%, #c4bdb4 100%)",
			"gradient": "linear-gradient(180deg, #d8d2ca 0%, #e8e4de 50%, #d8d2ca 100%)",
			"fabric": "repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(0,0,0,0.02) 2px, rgba(0,0,0,0.02) 4px), repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.01) 2px, rgba(0,0,0,0.01) 4px), #e8e4de"
		}
	}
}
