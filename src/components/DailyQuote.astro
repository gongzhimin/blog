---
type Props = {
  english: string;
  chinese: string;
  author?: string;
  year: number;
  copyrightLabel: string;
};

const { english, chinese, author, year, copyrightLabel } = Astro.props;
---

<footer class="daily-quote">
  <div class="daily-quote__text">
    <p class="daily-quote__english">“{english}”</p>
    <p class="daily-quote__chinese">{chinese}</p>
  </div>
  <div class="daily-quote__meta">
    {author && <p class="daily-quote__author">— {author}</p>}
    <p class="daily-quote__copyright">© {year} · {copyrightLabel}</p>
  </div>
</footer>
