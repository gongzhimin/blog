---
import '../styles/global.css';
import type { CollectionEntry } from 'astro:content';
import Giscus from '../components/Giscus.astro';

type Props = (CollectionEntry<'blog'>['data'] | CollectionEntry<'life'>['data']) & {
  collection: 'blog' | 'life';
};

const { title, description, collection } = Astro.props;
const tags = 'tags' in Astro.props ? Astro.props.tags : [];
const pubDatetime = 'pubDatetime' in Astro.props ? Astro.props.pubDatetime : null;
const date = 'date' in Astro.props ? Astro.props.date : null;
const displayDate = pubDatetime || date;
const isBlog = collection === 'blog';
const label = isBlog ? 'Technical note' : 'Essay';
const widthClass = isBlog ? 'site-shell--narrow' : 'site-shell--compact';

if (!displayDate) {
  throw new Error(`Missing post date for ${title}`);
}

const formattedDate = displayDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: isBlog ? 'short' : 'long',
  day: 'numeric',
});
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Zhimin</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
  </head>
  <body>
    <main class={`site-shell ${widthClass} article-page`}>
      <a href="/" class="article-page__back">← Back</a>

      <header class="article-hero">
        <div class="article-hero__meta">
          <time>{formattedDate}</time>
          <span class="editorial-note">{label}</span>
        </div>
        <h1 class="article-title">
          {title}
        </h1>
        {description && (
          <p class="article-dek">
            {description}
          </p>
        )}
        {isBlog && tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => (
              <span class="article-tag">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <article class="article-body">
        <slot />
      </article>

      <Giscus />
    </main>
  </body>
</html>
