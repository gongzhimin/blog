{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "homepage-config.schema.json",
  "title": "首页流式双开书配置",
  "description": "首页文案、独立区域布局、生活与技术目录、位置级文字样式和书本材质配置。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content",
    "layout",
    "catalogs",
    "textStyles",
    "materials"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "关联本 Schema，为编辑器提供中文说明和自动补全。"
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "layout": {
      "type": "object",
      "description": "每个页面区域独立管理的尺寸和间距。",
      "additionalProperties": false,
      "required": [
        "navigation",
        "bookRegion",
        "book",
        "lifePage",
        "technicalPage",
        "footer"
      ],
      "properties": {
        "navigation": {
          "type": "object",
          "description": "导航栏独立的高度、留白、间距和标题隐藏阈值。",
          "additionalProperties": false,
          "required": [
            "minimumHeight",
            "fluidHeight",
            "maximumHeight",
            "inlineGapFixed",
            "inlineGapProportional",
            "sectionGap",
            "linkGap",
            "titleMaxWidth",
            "titleHideThreshold",
            "themeToggleSize",
            "themeIconSize"
          ],
          "properties": {
            "minimumHeight": {
              "$ref": "#/$defs/length",
              "description": "导航栏最小高度。"
            },
            "fluidHeight": {
              "$ref": "#/$defs/length",
              "description": "导航栏随视口变化的流式高度。"
            },
            "maximumHeight": {
              "$ref": "#/$defs/length",
              "description": "导航栏最大高度。"
            },
            "inlineGapFixed": {
              "$ref": "#/$defs/length",
              "description": "导航内容左右固定留白。"
            },
            "inlineGapProportional": {
              "$ref": "#/$defs/length",
              "description": "导航内容左右比例留白；实际取固定值与比例值中较小者。"
            },
            "sectionGap": {
              "$ref": "#/$defs/length",
              "description": "品牌、标题和链接区之间的距离。"
            },
            "linkGap": {
              "$ref": "#/$defs/length",
              "description": "导航链接之间的距离。"
            },
            "titleMaxWidth": {
              "$ref": "#/$defs/length",
              "description": "导航中间标题的最大宽度。"
            },
            "titleHideThreshold": {
              "$ref": "#/$defs/length",
              "description": "导航容器低于此宽度时隐藏中间标题。"
            },
            "themeToggleSize": {
              "$ref": "#/$defs/length",
              "description": "主题切换按钮尺寸。"
            },
            "themeIconSize": {
              "$ref": "#/$defs/length",
              "description": "主题图标尺寸。"
            }
          }
        },
        "bookRegion": {
          "type": "object",
          "description": "书本区域独立的最小高度和窗口边界间隔。",
          "additionalProperties": false,
          "required": [
            "minimumHeight",
            "inlineGapFixed",
            "inlineGapProportional",
            "blockGapFixed",
            "blockGapProportional"
          ],
          "properties": {
            "minimumHeight": {
              "$ref": "#/$defs/length",
              "description": "书本区域最小高度，较矮窗口允许页面纵向滚动。"
            },
            "inlineGapFixed": {
              "$ref": "#/$defs/length",
              "description": "书本与窗口左右边界的固定间隔。"
            },
            "inlineGapProportional": {
              "$ref": "#/$defs/length",
              "description": "书本与窗口左右边界的比例间隔；实际取两者中较小者。"
            },
            "blockGapFixed": {
              "$ref": "#/$defs/length",
              "description": "书本与内容区上下边界的固定间隔。"
            },
            "blockGapProportional": {
              "$ref": "#/$defs/length",
              "description": "书本与内容区上下边界的比例间隔。"
            }
          }
        },
        "book": {
          "type": "object",
          "description": "整本双开书独立的比例、参考尺寸和物理材质尺寸。",
          "additionalProperties": false,
          "required": [
            "aspectRatio",
            "referenceMinimumWidth",
            "referenceMinimumHeight",
            "perspective",
            "rotateX",
            "shadowOffsetY",
            "shadowBlur",
            "coverInsetTop",
            "coverInsetInline",
            "coverInsetBottom",
            "coverRadius",
            "bindingWidth",
            "edgeWidth",
            "gutterWidth"
          ],
          "properties": {
            "aspectRatio": {
              "$ref": "#/$defs/ratio",
              "description": "书本固定宽高比，配置模块会自动派生数值比例。"
            },
            "referenceMinimumWidth": {
              "$ref": "#/$defs/length",
              "description": "设计校准使用的参考最小宽度，不阻止书本继续缩小。"
            },
            "referenceMinimumHeight": {
              "$ref": "#/$defs/length",
              "description": "设计校准使用的参考最小高度，不阻止书本继续缩小。"
            },
            "perspective": {
              "$ref": "#/$defs/length",
              "description": "书本 3D 透视距离。"
            },
            "rotateX": {
              "$ref": "#/$defs/angle",
              "description": "书本沿 X 轴的轻微倾角。"
            },
            "shadowOffsetY": {
              "$ref": "#/$defs/length",
              "description": "书本投影向下偏移。"
            },
            "shadowBlur": {
              "$ref": "#/$defs/length",
              "description": "书本投影模糊半径。"
            },
            "coverInsetTop": {
              "$ref": "#/$defs/length",
              "description": "硬壳封面超出纸页顶部的距离。"
            },
            "coverInsetInline": {
              "$ref": "#/$defs/length",
              "description": "硬壳封面超出纸页左右的距离。"
            },
            "coverInsetBottom": {
              "$ref": "#/$defs/length",
              "description": "硬壳封面超出纸页底部的距离。"
            },
            "coverRadius": {
              "$ref": "#/$defs/length",
              "description": "封面圆角。"
            },
            "bindingWidth": {
              "$ref": "#/$defs/length",
              "description": "装订布宽度。"
            },
            "edgeWidth": {
              "$ref": "#/$defs/length",
              "description": "左右书口纸层宽度。"
            },
            "gutterWidth": {
              "$ref": "#/$defs/length",
              "description": "中央中缝宽度。"
            }
          }
        },
        "lifePage": {
          "$ref": "#/$defs/pageLayout",
          "description": "生活书页独立的内边距、目录间距、入口和页码位置。"
        },
        "technicalPage": {
          "$ref": "#/$defs/pageLayout",
          "description": "技术书页独立的内边距、目录间距、入口和页码位置。"
        },
        "footer": {
          "type": "object",
          "description": "每日一句与版权区域独立的高度、留白和文字间距。",
          "additionalProperties": false,
          "required": [
            "minimumHeight",
            "fluidHeight",
            "maximumHeight",
            "inlineGapFixed",
            "inlineGapProportional",
            "paddingTop",
            "paddingBottom",
            "englishTranslationGap",
            "translationMetaGap",
            "authorCopyrightGap"
          ],
          "properties": {
            "minimumHeight": {
              "$ref": "#/$defs/length",
              "description": "页脚最小高度。"
            },
            "fluidHeight": {
              "$ref": "#/$defs/length",
              "description": "页脚流式高度。"
            },
            "maximumHeight": {
              "$ref": "#/$defs/length",
              "description": "页脚最大高度。"
            },
            "inlineGapFixed": {
              "$ref": "#/$defs/length",
              "description": "页脚内容左右固定留白。"
            },
            "inlineGapProportional": {
              "$ref": "#/$defs/length",
              "description": "页脚内容左右比例留白。"
            },
            "paddingTop": {
              "$ref": "#/$defs/length",
              "description": "页脚顶部内边距。"
            },
            "paddingBottom": {
              "$ref": "#/$defs/length",
              "description": "页脚底部内边距。"
            },
            "englishTranslationGap": {
              "$ref": "#/$defs/length",
              "description": "英文句子与中文译文间距。"
            },
            "translationMetaGap": {
              "$ref": "#/$defs/length",
              "description": "译文与作者信息间距。"
            },
            "authorCopyrightGap": {
              "$ref": "#/$defs/length",
              "description": "窄屏作者与版权之间的间距。"
            }
          }
        }
      }
    },
    "catalogs": {
      "type": "object",
      "description": "生活与技术目录分别管理的数量、阈值、日期格式和窄页间距。",
      "additionalProperties": false,
      "required": ["life", "technical"],
      "properties": {
        "life": {
          "$ref": "#/$defs/catalog",
          "description": "生活目录独立参数。"
        },
        "technical": {
          "$ref": "#/$defs/catalog",
          "description": "技术目录独立参数。"
        }
      }
    },
    "textStyles": {
      "type": "object",
      "description": "每处文字独立管理的字体、最小字号、流式字号、最大字号和明暗颜色。",
      "additionalProperties": false,
      "required": [
        "navigation",
        "lifePage",
        "technicalPage",
        "footer",
        "lifeDirectory",
        "technicalDirectory"
      ],
      "properties": {
        "navigation": {
          "$ref": "#/$defs/navigationTextStyles",
          "description": "导航品牌、导航标题和四个链接分别独立配置。"
        },
        "lifePage": {
          "$ref": "#/$defs/pageTextStyles",
          "description": "生活页眉、Part、目录标题、日期、入口和页码分别独立配置。"
        },
        "technicalPage": {
          "$ref": "#/$defs/pageTextStyles",
          "description": "技术页目录标题等文字使用独立参数，不与生活页共享。"
        },
        "footer": {
          "$ref": "#/$defs/footerTextStyles",
          "description": "英文句子、译文、作者和版权分别独立配置。"
        },
        "lifeDirectory": {
          "$ref": "#/$defs/directoryTextStyles",
          "description": "生活子目录页码独立配置。"
        },
        "technicalDirectory": {
          "$ref": "#/$defs/directoryTextStyles",
          "description": "技术子目录页码独立配置。"
        }
      }
    },
    "materials": {
      "$ref": "#/$defs/materials"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "length": {
      "type": "string",
      "pattern": "^-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:rem|px|%|svh|svw|vw|vh|em|cqw|cqh|cqi|cqb)$"
    },
    "angle": {
      "type": "string",
      "pattern": "^-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:deg|rad|turn)$"
    },
    "ratio": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d+)?\\s*/\\s*\\d+(?:\\.\\d+)?$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "dateFormat": {
      "type": "string",
      "pattern": "^(?:YYYY|MM|DD|[.\\-/\\s])+$"
    },
    "content": {
      "type": "object",
      "description": "首页显示文字。",
      "additionalProperties": false,
      "required": [
        "siteName",
        "navigationTitle",
        "copyrightLabel",
        "navigation",
        "life",
        "technical"
      ],
      "properties": {
        "siteName": {
          "$ref": "#/$defs/text",
          "description": "导航品牌文字。"
        },
        "navigationTitle": {
          "$ref": "#/$defs/text",
          "description": "导航中间标题。"
        },
        "copyrightLabel": {
          "$ref": "#/$defs/text",
          "description": "版权年份与分隔点之后的文字。"
        },
        "navigation": {
          "$ref": "#/$defs/navigationLabels"
        },
        "life": {
          "$ref": "#/$defs/bookSection"
        },
        "technical": {
          "$ref": "#/$defs/bookSection"
        }
      }
    },
    "navigationLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifeLabel",
        "technicalLabel",
        "aboutLabel",
        "rssLabel"
      ],
      "properties": {
        "lifeLabel": {
          "$ref": "#/$defs/text",
          "description": "生活链接文字。"
        },
        "technicalLabel": {
          "$ref": "#/$defs/text",
          "description": "技术链接文字。"
        },
        "aboutLabel": {
          "$ref": "#/$defs/text",
          "description": "关于链接文字。"
        },
        "rssLabel": {
          "$ref": "#/$defs/text",
          "description": "RSS 链接文字。"
        }
      }
    },
    "bookSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outerRunningLabel",
        "innerRunningLabel",
        "partLabel",
        "archiveLabel",
        "homepageFolio",
        "directoryFolio"
      ],
      "properties": {
        "outerRunningLabel": {
          "$ref": "#/$defs/text"
        },
        "innerRunningLabel": {
          "$ref": "#/$defs/text"
        },
        "partLabel": {
          "$ref": "#/$defs/text"
        },
        "archiveLabel": {
          "$ref": "#/$defs/text"
        },
        "homepageFolio": {
          "$ref": "#/$defs/text"
        },
        "directoryFolio": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "pageLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paddingTop",
        "paddingInline",
        "paddingBottom",
        "partMarginTop",
        "partMarginBottom",
        "partPaddingTop",
        "catalogGap",
        "catalogColumnGap",
        "archiveBottom",
        "folioBottom"
      ],
      "properties": {
        "paddingTop": {
          "$ref": "#/$defs/length"
        },
        "paddingInline": {
          "$ref": "#/$defs/length"
        },
        "paddingBottom": {
          "$ref": "#/$defs/length"
        },
        "partMarginTop": {
          "$ref": "#/$defs/length"
        },
        "partMarginBottom": {
          "$ref": "#/$defs/length"
        },
        "partPaddingTop": {
          "$ref": "#/$defs/length"
        },
        "catalogGap": {
          "$ref": "#/$defs/length"
        },
        "catalogColumnGap": {
          "$ref": "#/$defs/length"
        },
        "archiveBottom": {
          "$ref": "#/$defs/length"
        },
        "folioBottom": {
          "$ref": "#/$defs/length"
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wideMaximumEntries",
        "narrowMaximumEntries",
        "narrowBookWidth",
        "extremeBookWidth",
        "titleMaximumLines",
        "wideDateFormat",
        "compactDateFormat",
        "narrowRowGap"
      ],
      "properties": {
        "wideMaximumEntries": {
          "$ref": "#/$defs/positiveInteger",
          "description": "宽页最多准备的文章数量。"
        },
        "narrowMaximumEntries": {
          "$ref": "#/$defs/positiveInteger",
          "description": "窄页最多显示的文章数量。"
        },
        "narrowBookWidth": {
          "$ref": "#/$defs/length",
          "description": "进入两行目录布局的整本书宽度阈值。"
        },
        "extremeBookWidth": {
          "$ref": "#/$defs/length",
          "description": "改用紧凑日期的整本书宽度阈值。"
        },
        "titleMaximumLines": {
          "$ref": "#/$defs/positiveInteger",
          "description": "目录标题最多显示行数。"
        },
        "wideDateFormat": {
          "$ref": "#/$defs/dateFormat",
          "description": "宽页日期格式。"
        },
        "compactDateFormat": {
          "$ref": "#/$defs/dateFormat",
          "description": "极窄页日期格式。"
        },
        "narrowRowGap": {
          "$ref": "#/$defs/length",
          "description": "窄页标题与日期之间的行间距。"
        }
      }
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fontFamily",
        "minimumSize",
        "fluidSize",
        "maximumSize",
        "lightColor",
        "darkColor"
      ],
      "properties": {
        "fontFamily": {
          "type": "string",
          "enum": ["serif", "sans", "monospace"],
          "description": "该位置独立使用的字体族。"
        },
        "minimumSize": {
          "$ref": "#/$defs/length",
          "description": "该位置不会再缩小的最小字号。"
        },
        "fluidSize": {
          "$ref": "#/$defs/length",
          "description": "相对所属区域容器的流式字号。"
        },
        "maximumSize": {
          "$ref": "#/$defs/length",
          "description": "该位置最大字号。"
        },
        "lightColor": {
          "$ref": "#/$defs/color",
          "description": "亮色模式颜色。"
        },
        "darkColor": {
          "$ref": "#/$defs/color",
          "description": "暗色模式颜色。"
        }
      }
    },
    "navigationTextStyles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand",
        "title",
        "lifeLink",
        "technicalLink",
        "aboutLink",
        "rssLink"
      ],
      "properties": {
        "brand": {
          "$ref": "#/$defs/textStyle"
        },
        "title": {
          "$ref": "#/$defs/textStyle"
        },
        "lifeLink": {
          "$ref": "#/$defs/textStyle"
        },
        "technicalLink": {
          "$ref": "#/$defs/textStyle"
        },
        "aboutLink": {
          "$ref": "#/$defs/textStyle"
        },
        "rssLink": {
          "$ref": "#/$defs/textStyle"
        }
      }
    },
    "pageTextStyles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runningOuter",
        "runningInner",
        "partLink",
        "catalogTitle",
        "catalogDate",
        "archiveLink",
        "folio"
      ],
      "properties": {
        "runningOuter": {
          "$ref": "#/$defs/textStyle"
        },
        "runningInner": {
          "$ref": "#/$defs/textStyle"
        },
        "partLink": {
          "$ref": "#/$defs/textStyle"
        },
        "catalogTitle": {
          "$ref": "#/$defs/textStyle"
        },
        "catalogDate": {
          "$ref": "#/$defs/textStyle"
        },
        "archiveLink": {
          "$ref": "#/$defs/textStyle"
        },
        "folio": {
          "$ref": "#/$defs/textStyle"
        }
      }
    },
    "footerTextStyles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quoteEnglish",
        "quoteTranslation",
        "quoteAuthor",
        "copyright"
      ],
      "properties": {
        "quoteEnglish": {
          "$ref": "#/$defs/textStyle"
        },
        "quoteTranslation": {
          "$ref": "#/$defs/textStyle"
        },
        "quoteAuthor": {
          "$ref": "#/$defs/textStyle"
        },
        "copyright": {
          "$ref": "#/$defs/textStyle"
        }
      }
    },
    "directoryTextStyles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["folio"],
      "properties": {
        "folio": {
          "$ref": "#/$defs/textStyle"
        }
      }
    },
    "materials": {
      "type": "object",
      "description": "整本书的材质颜色和纹理。",
      "additionalProperties": false,
      "required": [
        "paperColor",
        "coverColor",
        "bindingColor",
        "pageEdgeColor",
        "gutterColor",
        "pageTextColor",
        "pageMutedColor",
        "pageAccentColor",
        "bookShadowColor",
        "paperTextureOpacity"
      ],
      "properties": {
        "paperColor": {
          "$ref": "#/$defs/color"
        },
        "coverColor": {
          "$ref": "#/$defs/color"
        },
        "bindingColor": {
          "$ref": "#/$defs/color"
        },
        "pageEdgeColor": {
          "$ref": "#/$defs/color"
        },
        "gutterColor": {
          "$ref": "#/$defs/color"
        },
        "pageTextColor": {
          "$ref": "#/$defs/color"
        },
        "pageMutedColor": {
          "$ref": "#/$defs/color"
        },
        "pageAccentColor": {
          "$ref": "#/$defs/color"
        },
        "bookShadowColor": {
          "$ref": "#/$defs/color"
        },
        "paperTextureOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^(?:#[\\da-fA-F]{3,8}|rgba?\\(\\s*[\\d.%\\s,/-]+\\))$"
    }
  }
}
