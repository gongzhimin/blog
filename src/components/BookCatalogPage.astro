---
type Entry = {
  title: string;
  href: string;
  date: string;
  compactDate: string;
  mobileHidden: boolean;
};

type Props = {
  section: "life" | "technical";
  runningLabel: "CONTENTS" | "NOTES";
  partLabel: "Part I · Life" | "Part II · Technology";
  entries: Entry[];
  archiveHref: string;
  archiveLabel: string;
};

const {
  section,
  runningLabel,
  partLabel,
  entries,
  archiveHref,
  archiveLabel,
} = Astro.props;
---

<section
  class="book-page"
  data-section={section}
  aria-label={partLabel}
>
  <header class="book-page__running-head">
    <strong>ZHIMIN</strong>
    <span>{runningLabel}</span>
  </header>

  <p class="book-page__part">{partLabel}</p>

  <ol class="catalog-list">
    {
      entries.map((entry) => (
        <li
          class:list={[
            "catalog-entry",
            { "catalog-entry--mobile-hidden": entry.mobileHidden },
          ]}
        >
          <a href={entry.href}>
            <span class="catalog-entry__title">{entry.title}</span>
            <span class="catalog-entry__leader" aria-hidden="true"></span>
            <time class="catalog-entry__date catalog-entry__date--desktop">
              {entry.date}
            </time>
            <time class="catalog-entry__date catalog-entry__date--mobile">
              {entry.compactDate}
            </time>
          </a>
        </li>
      ))
    }
  </ol>

  <a class="book-page__archive" href={archiveHref}>{archiveLabel}</a>
</section>
