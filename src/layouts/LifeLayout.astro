---
import '../styles/global.css';
import type { CollectionEntry } from 'astro:content';
import Giscus from '../components/Giscus.astro';

type Props = CollectionEntry<'life'>['data'];

const { title, date, description } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Zhimin</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
  </head>
  <body>
    <main class="site-shell site-shell--compact article-page">
      <a href="/" class="article-page__back">← Back</a>

      <header class="article-hero">
        <div class="article-hero__meta">
          <time>{formattedDate}</time>
          <span class="editorial-note">Essay</span>
        </div>
        <h1 class="article-title">
          {title}
        </h1>
        {description && (
          <p class="article-dek">
            {description}
          </p>
        )}
      </header>

      <article class="article-body life-article">
        <slot />
      </article>

      <Giscus />

    </main>
  </body>
</html>
