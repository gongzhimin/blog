{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "homepage-config.schema.json",
  "title": "Zhimin 首页组件配置",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "navigation",
    "book",
    "footer",
    "directories"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "navigation": {
      "type": "object",
      "description": "导航组件：文案、尺寸、间距、各链接文字和主题按钮。",
      "required": [
        "content",
        "size",
        "spacing",
        "brand",
        "title",
        "links",
        "themeToggle"
      ],
      "properties": {
        "content": {
          "type": "object",
          "description": "导航中的站点名称和居中标题。",
          "required": ["siteName", "title"],
          "properties": {
            "siteName": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 }
          }
        },
        "size": {
          "$ref": "#/$defs/clampedHeight",
          "description": "导航组件自身的最小、流式和最大高度。"
        },
        "spacing": {
          "type": "object",
          "description": "导航左右留白以及品牌、标题、链接之间的间距。",
          "required": [
            "inlineGapFixed",
            "inlineGapProportional",
            "sectionGap",
            "linkGap"
          ],
          "additionalProperties": { "$ref": "#/$defs/cssLength" }
        },
        "brand": {
          "$ref": "#/$defs/clampedText",
          "description": "站点品牌文字。"
        },
        "title": {
          "allOf": [
            { "$ref": "#/$defs/clampedText" },
            {
              "type": "object",
              "required": ["maximumWidth", "hideThreshold"],
              "properties": {
                "maximumWidth": { "$ref": "#/$defs/cssLength" },
                "hideThreshold": { "$ref": "#/$defs/cssLength" }
              }
            }
          ],
          "description": "导航中央标题及其隐藏阈值。"
        },
        "links": {
          "type": "object",
          "description": "生活、技术、关于和 RSS 四个独立导航链接。",
          "required": ["life", "technical", "about", "rss"],
          "additionalProperties": { "$ref": "#/$defs/navigationLink" }
        },
        "themeToggle": {
          "type": "object",
          "description": "明暗主题按钮尺寸。",
          "required": ["size", "iconSize"],
          "properties": {
            "size": { "$ref": "#/$defs/cssLength" },
            "iconSize": { "$ref": "#/$defs/cssLength" }
          }
        }
      }
    },
    "book": {
      "type": "object",
      "description": "首页双开书组件及全部物理、材质和页内排版参数。",
      "required": [
        "size",
        "stage",
        "perspective",
        "shadow",
        "cover",
        "pageEdges",
        "innerSpine",
        "paper",
        "pages"
      ],
      "properties": {
        "size": {
          "type": "object",
          "description": "书本按窗口宽度比例取值，并使用硬最小宽度和固定宽高比。",
          "required": ["viewportWidth", "minimumWidth", "aspectRatio"],
          "properties": {
            "viewportWidth": { "$ref": "#/$defs/cssLength" },
            "minimumWidth": { "$ref": "#/$defs/cssLength" },
            "aspectRatio": { "$ref": "#/$defs/cssRatio" }
          }
        },
        "stage": {
          "type": "object",
          "description": "书本舞台的左右留白和上下内边距。",
          "required": [
            "inlineGapFixed",
            "inlineGapProportional",
            "paddingTop",
            "paddingBottom"
          ],
          "additionalProperties": { "$ref": "#/$defs/cssLength" }
        },
        "perspective": {
          "type": "object",
          "description": "书本整体 3D 透视。",
          "required": ["distance", "rotateX"],
          "properties": {
            "distance": { "$ref": "#/$defs/cssLength" },
            "rotateX": { "$ref": "#/$defs/cssAngle" }
          }
        },
        "shadow": {
          "type": "object",
          "description": "整本书投影。",
          "required": ["offsetY", "blur", "color"],
          "properties": {
            "offsetY": { "$ref": "#/$defs/cssLength" },
            "blur": { "$ref": "#/$defs/cssLength" },
            "color": { "$ref": "#/$defs/cssColor" }
          }
        },
        "cover": {
          "type": "object",
          "description": "硬壳封面的外扩、圆角和颜色。",
          "required": [
            "insetTop",
            "insetInline",
            "insetBottom",
            "radius",
            "color"
          ],
          "properties": {
            "insetTop": { "$ref": "#/$defs/cssLength" },
            "insetInline": { "$ref": "#/$defs/cssLength" },
            "insetBottom": { "$ref": "#/$defs/cssLength" },
            "radius": { "$ref": "#/$defs/cssLength" },
            "color": { "$ref": "#/$defs/cssColor" }
          }
        },
        "pageEdges": {
          "type": "object",
          "description": "左右书口厚度和纸张边缘颜色。",
          "required": ["width", "color"],
          "properties": {
            "width": { "$ref": "#/$defs/cssLength" },
            "color": { "$ref": "#/$defs/cssColor" }
          }
        },
        "innerSpine": {
          "type": "object",
          "description": "纸页下方的深色书内脊、1px 中缝、阴影和上下弧形端面。",
          "required": [
            "width",
            "color",
            "centerColor",
            "seamWidth",
            "seamColor",
            "seamShadowBlur",
            "seamShadowColor",
            "capWidth",
            "capHeight",
            "capRadius"
          ],
          "properties": {
            "width": { "$ref": "#/$defs/cssLength" },
            "color": { "$ref": "#/$defs/cssColor" },
            "centerColor": { "$ref": "#/$defs/cssColor" },
            "seamWidth": { "$ref": "#/$defs/cssLength" },
            "seamColor": { "$ref": "#/$defs/cssColor" },
            "seamShadowBlur": { "$ref": "#/$defs/cssLength" },
            "seamShadowColor": { "$ref": "#/$defs/cssColor" },
            "capWidth": { "$ref": "#/$defs/cssLength" },
            "capHeight": { "$ref": "#/$defs/cssLength" },
            "capRadius": { "$ref": "#/$defs/cssLength" }
          }
        },
        "paper": {
          "type": "object",
          "description": "纸张颜色、正文颜色和纹理透明度。",
          "required": [
            "color",
            "textColor",
            "mutedColor",
            "accentColor",
            "textureOpacity"
          ],
          "properties": {
            "color": { "$ref": "#/$defs/cssColor" },
            "textColor": { "$ref": "#/$defs/cssColor" },
            "mutedColor": { "$ref": "#/$defs/cssColor" },
            "accentColor": { "$ref": "#/$defs/cssColor" },
            "textureOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "pages": {
          "type": "object",
          "description": "纸页共享弯曲参数，以及生活页和技术页的独立内容与排版。",
          "required": ["shared", "life", "technical"],
          "properties": {
            "shared": {
              "type": "object",
              "description": "左右页镜像使用的弯曲角度和中缝渐变阴影。",
              "required": [
                "rotationY",
                "innerShadowWidth",
                "innerShadowColor"
              ],
              "properties": {
                "rotationY": { "$ref": "#/$defs/cssAngle" },
                "innerShadowWidth": { "$ref": "#/$defs/cssLength" },
                "innerShadowColor": { "$ref": "#/$defs/cssColor" }
              }
            },
            "life": {
              "$ref": "#/$defs/bookPage",
              "description": "生活书页的文案、间距、目录和各文字角色。"
            },
            "technical": {
              "$ref": "#/$defs/bookPage",
              "description": "技术书页的文案、间距、目录和各文字角色。"
            }
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "description": "每日一句和版权页脚组件。",
      "required": [
        "content",
        "size",
        "spacing",
        "quoteEnglish",
        "quoteTranslation",
        "quoteAuthor",
        "copyright"
      ],
      "properties": {
        "content": {
          "type": "object",
          "required": ["copyrightLabel"],
          "properties": {
            "copyrightLabel": { "type": "string", "minLength": 1 }
          }
        },
        "size": {
          "type": "object",
          "required": ["minimumHeight"],
          "properties": {
            "minimumHeight": { "$ref": "#/$defs/cssLength" }
          }
        },
        "spacing": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/cssLength" }
        },
        "quoteEnglish": { "$ref": "#/$defs/clampedText" },
        "quoteTranslation": { "$ref": "#/$defs/clampedText" },
        "quoteAuthor": { "$ref": "#/$defs/clampedText" },
        "copyright": { "$ref": "#/$defs/clampedText" }
      }
    },
    "directories": {
      "type": "object",
      "description": "生活目录页和技术目录页的独立页码组件。",
      "required": ["life", "technical"],
      "properties": {
        "life": { "$ref": "#/$defs/directory" },
        "technical": { "$ref": "#/$defs/directory" }
      }
    }
  },
  "$defs": {
    "cssLength": {
      "type": "string",
      "pattern": "^-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:rem|px|%|svh|svw|vw|vh|em|cqw|cqh|cqi|cqb)$"
    },
    "cssAngle": {
      "type": "string",
      "pattern": "^-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:deg|rad|turn)$"
    },
    "cssRatio": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d+)?\\s*/\\s*\\d+(?:\\.\\d+)?$"
    },
    "cssColor": {
      "type": "string",
      "pattern": "^(?:#[0-9a-fA-F]{3,8}|rgba?\\(.+\\))$"
    },
    "fontFamily": {
      "type": "string",
      "enum": ["serif", "sans", "monospace"]
    },
    "clampedHeight": {
      "type": "object",
      "required": ["minimumHeight", "fluidHeight", "maximumHeight"],
      "properties": {
        "minimumHeight": { "$ref": "#/$defs/cssLength" },
        "fluidHeight": { "$ref": "#/$defs/cssLength" },
        "maximumHeight": { "$ref": "#/$defs/cssLength" }
      }
    },
    "clampedText": {
      "type": "object",
      "required": [
        "fontFamily",
        "minimumSize",
        "fluidSize",
        "maximumSize",
        "lightColor",
        "darkColor"
      ],
      "properties": {
        "fontFamily": { "$ref": "#/$defs/fontFamily" },
        "minimumSize": { "$ref": "#/$defs/cssLength" },
        "fluidSize": { "$ref": "#/$defs/cssLength" },
        "maximumSize": { "$ref": "#/$defs/cssLength" },
        "lightColor": { "$ref": "#/$defs/cssColor" },
        "darkColor": { "$ref": "#/$defs/cssColor" }
      }
    },
    "navigationLink": {
      "allOf": [
        { "$ref": "#/$defs/clampedText" },
        {
          "type": "object",
          "required": ["label", "href"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "href": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "bookText": {
      "type": "object",
      "required": ["fontFamily", "fontSize", "lightColor", "darkColor"],
      "properties": {
        "fontFamily": { "$ref": "#/$defs/fontFamily" },
        "fontSize": {
          "type": "string",
          "pattern": "^(?:\\d+(?:\\.\\d+)?|\\.\\d+)cqw$"
        },
        "lightColor": { "$ref": "#/$defs/cssColor" },
        "darkColor": { "$ref": "#/$defs/cssColor" }
      }
    },
    "catalog": {
      "type": "object",
      "required": [
        "wideMaximumEntries",
        "narrowMaximumEntries",
        "narrowBookWidth",
        "extremeBookWidth",
        "titleMaximumLines",
        "wideDateFormat",
        "compactDateFormat",
        "narrowRowGap"
      ],
      "properties": {
        "wideMaximumEntries": { "type": "integer", "minimum": 1 },
        "narrowMaximumEntries": { "type": "integer", "minimum": 1 },
        "narrowBookWidth": { "$ref": "#/$defs/cssLength" },
        "extremeBookWidth": { "$ref": "#/$defs/cssLength" },
        "titleMaximumLines": { "type": "integer", "minimum": 1 },
        "wideDateFormat": { "type": "string" },
        "compactDateFormat": { "type": "string" },
        "narrowRowGap": { "$ref": "#/$defs/cssLength" }
      }
    },
    "bookPage": {
      "type": "object",
      "required": [
        "content",
        "layout",
        "catalog",
        "runningOuter",
        "runningInner",
        "partLink",
        "catalogTitle",
        "catalogDate",
        "archiveLink",
        "folio"
      ],
      "properties": {
        "content": {
          "type": "object",
          "required": [
            "outerRunningLabel",
            "innerRunningLabel",
            "partLabel",
            "partHref",
            "archiveLabel",
            "archiveHref",
            "homepageFolio"
          ],
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "layout": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/cssLength" }
        },
        "catalog": { "$ref": "#/$defs/catalog" },
        "runningOuter": { "$ref": "#/$defs/bookText" },
        "runningInner": { "$ref": "#/$defs/bookText" },
        "partLink": { "$ref": "#/$defs/bookText" },
        "catalogTitle": { "$ref": "#/$defs/bookText" },
        "catalogDate": { "$ref": "#/$defs/bookText" },
        "archiveLink": { "$ref": "#/$defs/bookText" },
        "folio": { "$ref": "#/$defs/bookText" }
      }
    },
    "directory": {
      "type": "object",
      "required": ["folio"],
      "properties": {
        "folio": {
          "type": "object",
          "required": [
            "content",
            "fontFamily",
            "fontSize",
            "lightColor",
            "darkColor"
          ],
          "properties": {
            "content": { "type": "string", "minLength": 1 },
            "fontFamily": { "$ref": "#/$defs/fontFamily" },
            "fontSize": { "$ref": "#/$defs/cssLength" },
            "lightColor": { "$ref": "#/$defs/cssColor" },
            "darkColor": { "$ref": "#/$defs/cssColor" }
          }
        }
      }
    }
  }
}
