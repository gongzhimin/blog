---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { readFileSync } from 'fs';
import quote from '../data/daily-quote.json';
import bookConfig from '../data/book-config.json';
import { renderMarkdown, stripLeadingTitle, romanTocPage } from '../lib/book-renderer.js';
import fontsCSS from '../styles/fonts.css?raw';
import bookContentCSS from '../styles/book-content.css?raw';
import codeHighlightCSS from '../styles/code-highlight.css?raw';
import bookTocCSS from '../styles/book-toc.css?raw';

const SITE_TITLE = bookConfig.footer.content.copyright;
const SITE_DESC = '文字留住瞬间。技术笔记与生活随笔。';

// Load KaTeX CSS so the measurement container can match rendered formula metrics
const katexCSS = readFileSync('node_modules/katex/dist/katex.min.css', 'utf8');

// Build measurement CSS from the same source.
// Article: straight selector swap + KaTeX CSS for formula layout accuracy.
const measureArticleCSS = katexCSS + codeHighlightCSS +
  bookContentCSS.replace(/\.sj-book \.book-content/g, '#__bap_inner');

// TOC: auto-generated from book-toc.css, with measurement-required
// properties (from steve-jobs.css) prepended so the container
// renders at the same dimensions as the real page.
const measureTocCSS =
  `#__toc{font-family:'Stempel-Garamond-W01-Roman',Georgia,"Times New Roman","Chiron Sung HK","Noto Serif SC","Songti SC","STSong","SimSun",serif;font-size:16px;line-height:1.7;overflow:hidden;overflow-wrap:break-word;word-break:break-word;width:300px;margin:80px auto}` +
  `#__toc h1{font-size:28px;font-weight:700;margin:0 0 20px;text-align:center}` +
  `#__toc ul{list-style:none;padding:0;margin:0}` +
  `#__toc li{margin-bottom:8px;font-size:15px}` +
  `#__toc a{color:#8b7355;text-decoration:none}` +
  bookTocCSS.replace(/\.sj-book \.table-contents/g, '#__toc');

type BlogPost = CollectionEntry<'blog'>;
type LifePost = CollectionEntry<'life'>;

function getPostDate(post: BlogPost | LifePost) {
  return 'pubDatetime' in post.data ? post.data.pubDatetime : post.data.date;
}

const lifePosts = (await getCollection('life'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const blogPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());

const allPosts = [...lifePosts, ...blogPosts].sort(
  (a, b) => getPostDate(b).valueOf() - getPostDate(a).valueOf(),
);

// Build article data for runtime pagination
function fmtDate(d: Date) {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
}

const articles = allPosts.map((post) => {
  const date = getPostDate(post);
  const bodyHTML = renderMarkdown(stripLeadingTitle(post.body || '', post.data.title));
  return {
    title: post.data.title,
    dateStr: fmtDate(date),
    bodyHTML,
  };
});

// TOC
const toc = '<div class="table-contents"><h1>目录</h1><ul>' +
  articles.map((a, i) =>
    `<li><a href="#page/${7 + i}">${a.title} <span>${1 + i}</span></a></li>`
  ).join('') +
  `</ul></div><span class="page-number">${romanTocPage(5)}</span>`;

// Estimate total pages (runtime will correct)
const estPages = 7 + articles.length * 3 + 2; // rough: 3 pages/article + covers
const runConfig = JSON.parse(JSON.stringify(bookConfig));
runConfig.book.turn.startPage = 7;
runConfig.book.turn.totalPages = estPages;
runConfig.book.turn.backPage = runConfig.book.turn.totalPages - 1;
runConfig.articles = articles;
runConfig.toc = toc;

const backPage = runConfig.book.turn.backPage;
const totalPages = runConfig.book.turn.totalPages;
const nav = bookConfig.nav;
const footer = bookConfig.footer;
const light = {
  nav: nav.light,
  footer: footer.light,
  background: bookConfig.backgrounds.light,
};
const pageDepthAttrs = { depth: '5' };

const homepageStyles = `
  html {
    min-height: 100%;
    background: ${light.background.fabric};
  }

  body {
    min-height: 100vh;
    overflow-x: auto !important;
    overflow-y: auto !important;
    color: #3a3a3a;
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    height: ${nav.height}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    border-bottom: 1px solid ${light.nav.border};
    background: rgba(232, 228, 222, 0.88);
    backdrop-filter: blur(8px);
    box-sizing: border-box;
  }

  .site-nav .inner {
    display: flex;
    align-items: center;
    gap: ${nav.innerGap}px;
  }

  .site-nav .brand {
    color: ${light.nav.brandText};
    font-size: ${nav.brand.fontSize}px;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .site-nav .links {
    display: flex;
    align-items: center;
    gap: ${nav.links.gap}px;
  }

  .site-nav .links a {
    color: ${light.nav.linkText};
    font-size: ${nav.links.fontSize}px;
    text-decoration: none;
  }

  .site-nav .links a:hover {
    color: ${light.nav.linkHover};
  }

  #canvas {
    visibility: hidden;
    width: ${bookConfig.book.canvasWidth}px !important;
    height: ${bookConfig.book.height}px !important;
    margin: 0 auto !important;
    padding: ${bookConfig.book.gap}px 0 !important;
  }

  .sj-book {
    width: ${bookConfig.book.width}px !important;
    height: ${bookConfig.book.height}px !important;
  }

  .sj-book .hard {
    width: ${bookConfig.book.hardPage.width}px;
    height: ${bookConfig.book.hardPage.height}px;
  }

  .sj-book .own-size {
    width: ${bookConfig.book.contentPage.width}px;
    height: ${bookConfig.book.contentPage.height}px;
  }

  .sj-book .p1 .side {
    width: ${bookConfig.book.spineStrip.width}px !important;
    left: ${bookConfig.book.spineStrip.left}px !important;
  }

  .sj-book .depth {
    top: ${bookConfig.book.depth.top}px;
    height: ${bookConfig.book.depth.height}px;
  }

  /* ── Cover sprites & content surface ───────────────── */
  .sj-book .p1,
  .sj-book .p2,
  .sj-book .p3 {
    background-color: white;
    background-image: url(/vendor/turnjs/pics/book-covers.jpg) !important;
    background-repeat: no-repeat;
    background-size: 2400px 600px;
  }
  .sj-book .p1  { background-position: 0 0 !important; }
  .sj-book .p2  { background-position: -483px 0 !important; }
  .sj-book .p3  { background-position: -1936px 0 !important; }
  /* Back-cover pages (.p${backPage}, .p${totalPages}) injected at runtime
     by orchestrator.js — not here, to avoid stale estimated page numbers. */

  /* ── Paper texture ──────────────────────────────────────── */
  .sj-book .own-size {
    background-color: #f2f1ec;
    background-image:
      linear-gradient(to bottom,
        rgba(60,55,48,0.035) 0%,
        transparent 10%,
        transparent 88%,
        rgba(60,55,48,0.032) 100%),
      radial-gradient(ellipse at 48% 36%,
        rgba(255,255,255,0.48) 0%,
        rgba(255,255,255,0.16) 38%,
        transparent 72%),
      linear-gradient(135deg,
        #fbfaf5 0%,
        #f2f1ec 48%,
        #e8e5dc 100%);
  }
  .sj-book .own-size.odd  { background-image: linear-gradient(to left,  #e8e5dc 95%, #cdc8bc 100%), linear-gradient(to bottom, rgba(60,55,48,0.035) 0%, transparent 10%, transparent 88%, rgba(60,55,48,0.032) 100%), radial-gradient(ellipse at 48% 36%, rgba(255,255,255,0.48) 0%, rgba(255,255,255,0.16) 38%, transparent 72%), linear-gradient(135deg, #fbfaf5 0%, #f2f1ec 48%, #e8e5dc 100%); }
  .sj-book .own-size.even { background-image: linear-gradient(to right, #e8e5dc 95%, #cdc8bc 100%), linear-gradient(to bottom, rgba(60,55,48,0.035) 0%, transparent 10%, transparent 88%, rgba(60,55,48,0.032) 100%), radial-gradient(ellipse at 48% 36%, rgba(255,255,255,0.48) 0%, rgba(255,255,255,0.16) 38%, transparent 72%), linear-gradient(135deg, #fbfaf5 0%, #f2f1ec 48%, #e8e5dc 100%); }

  .site-footer {
    text-align: center;
    padding: ${footer.padding.top}px 24px ${footer.padding.bottom}px;
    color: ${light.footer.text};
    font-size: ${footer.fontSize}px;
    border-top: 1px solid ${light.footer.border};
  }

  .site-footer .quote {
    color: ${light.footer.quote};
    font-style: italic;
    margin-bottom: 6px;
  }

  .site-footer .copyright {
    color: ${light.footer.copyright};
    font-size: ${footer.copyrightFontSize}px;
    margin-top: 8px;
  }
` + katexCSS + codeHighlightCSS + fontsCSS + bookContentCSS + bookTocCSS;

const quoteEnglish = quote.english || footer.content.quoteEnglish;
const quoteChinese = quote.chinese || footer.content.quoteChinese;
const quoteAuthor = quote.author || footer.content.author;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{SITE_TITLE}</title>
    <meta name="description" content={SITE_DESC} />
    <meta name="viewport" content="width=1050, user-scalable=no" />
    <link rel="preconnect" href="https://fonts.loli.net" />
    <link rel="preconnect" href="https://gstatic.loli.net" crossorigin />
    <link href="https://fonts.loli.net/css2?family=Chiron+Sung+HK&display=swap" rel="stylesheet" />
    <script is:inline src="/vendor/turnjs/jquery.min.1.7.js"></script>
    <script is:inline src="/vendor/turnjs/jquery-ui-1.8.20.custom.min.js"></script>
    <script is:inline src="/vendor/turnjs/jquery.mousewheel.min.js"></script>
    <script is:inline src="/vendor/turnjs/modernizr.2.5.3.min.js"></script>
    <script is:inline src="/vendor/turnjs/hash.js"></script>
    <link rel="stylesheet" href="/vendor/turnjs/css/jquery.ui.css" />
    <link rel="stylesheet" href="/vendor/turnjs/css/steve-jobs.css" />
    <style is:inline set:html={homepageStyles}></style>
  </head>
  <body>
    <header class="site-nav">
      <div class="inner">
        <a class="brand" href="/">{nav.brand.text}</a>
        <nav class="links">
          {nav.links.items.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <div id="canvas">
        <div id="book-zoom">
          <div class="sj-book">
            <div {...pageDepthAttrs} class="hard">
              <div class="side"></div>
            </div>
            <div {...pageDepthAttrs} class="hard front-side">
              <div class="depth"></div>
            </div>
            <div class="own-size"></div>
            <div class="own-size even"></div>
            <div class={`hard fixed back-side p${backPage}`}>
              <div class="depth"></div>
            </div>
            <div class={`hard p${totalPages}`}></div>
          </div>
        </div>
        <div id="slider-bar" class="turnjs-slider">
          <div id="slider"></div>
        </div>
      </div>
    </main>

    <footer class="site-footer">
      <div class="quote">"{quoteEnglish}"</div>
      <div>{quoteChinese}</div>
      <div style="margin-top:4px;color:#888">— {quoteAuthor}</div>
      <div class="copyright">
        &copy; {new Date().getFullYear()} · {footer.content.copyright}
      </div>
    </footer>

    <div
      id="book-data"
      hidden
      data-config={JSON.stringify(runConfig)}
    ></div>

    <script is:inline set:html={`var MEASURE_CSS={article:` + JSON.stringify(measureArticleCSS) + `,toc:` + JSON.stringify(measureTocCSS) + `};`}></script>
    <script is:inline src="/vendor/turnjs/js/paginator.js"></script>
    <script is:inline src="/vendor/turnjs/js/orchestrator.js"></script>
    <script is:inline src="/vendor/turnjs/js/book-app.js"></script>
  </body>
</html>
