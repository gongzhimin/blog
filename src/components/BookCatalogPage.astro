---
type Entry = {
  title: string;
  href: string;
  date: string;
  compactDate: string;
  mobileHidden: boolean;
};

type Props = {
  section: "life" | "technical";
  side: "left" | "right";
  outerRunningLabel: string;
  innerRunningLabel: string;
  partLabel: string;
  partHref: string;
  entries: Entry[];
  archiveHref: string;
  archiveLabel: string;
  folio: string;
};

const {
  section,
  side,
  outerRunningLabel,
  innerRunningLabel,
  partLabel,
  partHref,
  entries,
  archiveHref,
  archiveLabel,
  folio,
} = Astro.props;
---

<section
  class="book-page"
  data-section={section}
  aria-label={partLabel}
>
  <header class="book-page__running-head">
    {
      side === "left" ? (
        <>
          <span class="book-page__running-outer">{outerRunningLabel}</span>
          <span class="book-page__running-inner">{innerRunningLabel}</span>
        </>
      ) : (
        <>
          <span class="book-page__running-inner">{innerRunningLabel}</span>
          <span class="book-page__running-outer">{outerRunningLabel}</span>
        </>
      )
    }
  </header>

  <a class="book-page__part" href={partHref}>{partLabel}</a>

  <ol class="catalog-list">
    {
      entries.map((entry) => (
        <li
          class:list={[
            "catalog-entry",
            { "catalog-entry--mobile-hidden": entry.mobileHidden },
          ]}
        >
          <a href={entry.href}>
            <span class="catalog-entry__title">{entry.title}</span>
            <span class="catalog-entry__leader" aria-hidden="true"></span>
            <time class="catalog-entry__date catalog-entry__date--desktop">
              {entry.date}
            </time>
            <time class="catalog-entry__date catalog-entry__date--mobile">
              {entry.compactDate}
            </time>
          </a>
        </li>
      ))
    }
  </ol>

  <a class="book-page__archive" href={archiveHref}>{archiveLabel}</a>
  <span class="book-page__folio">{folio}</span>
</section>
