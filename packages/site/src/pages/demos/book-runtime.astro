---
import bookConfig from '../../data/book-config.json';
import sampleBook from '../../data/books/sample.json';
import { buildBook } from '@myblog/book-build';
import { buildHomepageStyles } from '../../internal/presentation/build-homepage-styles.mjs';
import { createJsonBookDocument } from '../../internal/sources/json-book-source.mjs';
import { loadSiteBookTheme } from '../../internal/load-book-theme.mjs';
import BookShell from '../../components/BookShell.astro';
import BookRuntimeAssets from '../../components/BookRuntimeAssets.astro';
import CursorDot from '../../components/CursorDot.astro';
import tokensCSS from '../../styles/tokens.css?raw';

const demoConfig = JSON.parse(JSON.stringify(bookConfig));
demoConfig.theme = { id: 'plain-manuscript' };
demoConfig.footer.content.copyright = 'Book Runtime Demo';
const theme = loadSiteBookTheme(demoConfig.theme.id);
const bookDocument = createJsonBookDocument(sampleBook);
const bookResult = buildBook({ document: bookDocument, config: demoConfig });
if (!bookResult.ok) throw new Error(JSON.stringify(bookResult.diagnostics));
const runtime = bookResult.value;
const runConfig = runtime.config;
runConfig.theme = theme.runtime;

const homepageStyles = buildHomepageStyles({
  book: demoConfig.book,
  cover: demoConfig.book.coverSprite,
  footer: demoConfig.footer,
  light: {
    nav: demoConfig.nav.light,
    footer: demoConfig.footer.light,
    background: demoConfig.backgrounds.light,
  },
  mobileCanvas: demoConfig.book.mobileCanvas,
  mobileContentPage: demoConfig.book.mobileContentPage,
  nav: demoConfig.nav,
  theme,
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>Book Runtime Demo</title>
    <meta name="viewport" content="width=1050, user-scalable=no" />
    <BookRuntimeAssets />
    <style is:inline set:html={tokensCSS}></style>
    <style is:inline set:html={homepageStyles}></style>
  </head>
  <body data-cursor-hover="nav">
    <header class="site-nav">
      <div class="inner">
        <a class="brand" href="/demos/book-runtime/">
          <span class="cursor-text">Book Runtime Demo</span>
        </a>
        <span class="nav-slogan">
          <span class="cursor-text">{demoConfig.nav.slogan}</span>
        </span>
      </div>
    </header>

    <BookShell
      runConfig={runConfig}
      measureArticleCSS={theme.measurement.articleCSS}
      measureTocCSS={theme.measurement.tocCSS}
    />
    <CursorDot />
  </body>
</html>
