---
import ThemeToggle from "./ThemeToggle.astro";

type Props = {
  siteName: string;
  title: string;
  lifeLabel: string;
  technicalLabel: string;
  aboutLabel: string;
  rssLabel: string;
};

const {
  siteName,
  title,
  lifeLabel,
  technicalLabel,
  aboutLabel,
  rssLabel,
} = Astro.props;
---

<header class="home-navigation">
  <nav class="home-navigation__inner" aria-label="主要导航">
    <a class="home-navigation__brand" href="/" aria-current="page">{siteName}</a>
    <span class="home-navigation__title" title={title}>{title}</span>

    <div class="home-navigation__links">
      <a class="home-navigation__link--life" href="/life">{lifeLabel}</a>
      <a class="home-navigation__link--technical" href="/blog">
        {technicalLabel}
      </a>
      <a class="home-navigation__link--about" href="/about">{aboutLabel}</a>
      <a class="home-navigation__link--rss" href="/rss.xml">{rssLabel}</a>
      <ThemeToggle />
    </div>
  </nav>
</header>
