---
import "../styles/global.css";
import "../styles/home.css";
import { getCollection } from "astro:content";
import SiteNavigation from "../components/SiteNavigation.astro";
import BookCatalogPage from "../components/BookCatalogPage.astro";
import DailyQuote from "../components/DailyQuote.astro";
import quote from "../data/daily-quote.json";
import homepageConfig from "../data/homepage-config.json";
import {
  buildHomepageCssVariables,
  validateHomepageConfig,
} from "../lib/homepage-config.mjs";
import { buildCatalogEntries } from "../lib/homepage.mjs";

validateHomepageConfig(homepageConfig);

const lifeEntries = buildCatalogEntries(await getCollection("life"), "/life");
const technicalEntries = buildCatalogEntries(
  await getCollection("blog"),
  "/blog",
);
const currentYear = new Date().getFullYear();
const homepageStyle = buildHomepageCssVariables(homepageConfig);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={homepageConfig.content.heroTitle}
    />
    <title>{homepageConfig.content.siteName}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS Feed"
      href="/rss.xml"
    />
  </head>
  <body class="home-body" style={homepageStyle}>
    <SiteNavigation siteName={homepageConfig.content.siteName} />

    <div class="home-shell">
      <main class="home-page">
        <header class="home-hero">
          <h1>{homepageConfig.content.heroTitle}</h1>
        </header>

        <section class="home-book-frame" aria-label="最新文章目录">
          <div class="home-book-cover" aria-hidden="true"></div>
          <div class="home-book-binding" aria-hidden="true"></div>
          <div
            class="home-book-edge home-book-edge--left"
            aria-hidden="true"
          ></div>
          <div
            class="home-book-edge home-book-edge--right"
            aria-hidden="true"
          ></div>

          <div class="home-book">
            <BookCatalogPage
              section="life"
              siteName={homepageConfig.content.siteName}
              runningLabel={homepageConfig.content.life.runningLabel}
              partLabel={homepageConfig.content.life.partLabel}
              entries={lifeEntries}
              archiveHref="/life"
              archiveLabel={homepageConfig.content.life.archiveLabel}
            />
            <BookCatalogPage
              section="technical"
              siteName={homepageConfig.content.siteName}
              runningLabel={homepageConfig.content.technical.runningLabel}
              partLabel={homepageConfig.content.technical.partLabel}
              entries={technicalEntries}
              archiveHref="/blog"
              archiveLabel={homepageConfig.content.technical.archiveLabel}
            />
          </div>

          <div class="home-book-gutter" aria-hidden="true"></div>
        </section>
      </main>

      <DailyQuote
        english={quote.english}
        chinese={quote.chinese}
        author={quote.author}
        year={currentYear}
        siteName={homepageConfig.content.siteName}
      />
    </div>
  </body>
</html>
